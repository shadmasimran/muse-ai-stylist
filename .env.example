# Free key from https://unsplash.com/developers  (create an app, copy the "Access Key")
UNSPLASH_ACCESS_KEY=your_key_here
# Alternative (new Pexels keys may be paused): https://www.pexels.com/api/
# PEXELS_API_KEY=your_key_here

# AI image generation (npm run generate). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# or: OPENAI_API_KEY=your_key_here   |  IMAGE_PROVIDER=gemini|openai|pollinations
